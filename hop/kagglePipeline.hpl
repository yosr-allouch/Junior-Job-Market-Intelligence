      <is_enabled>Y</is_enabled>
      <nr_valuename/>
      <descriptions_valuename>err_desc</descriptions_valuename>
      <fields_valuename/>
      <codes_valuename>err_code</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>
