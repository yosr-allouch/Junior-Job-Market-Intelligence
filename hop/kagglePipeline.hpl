      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Nettoyage du nom de l'entreprise (On utilise 'company_name' d'après ton Select Values)
var cleanCompanyName = (typeof company_name !== 'undefined' &amp;&amp; company_name !== "") ? company_name : "unknown";

// 2. Préparation des listes
var skillsList = (typeof skills !== 'undefined' &amp;&amp; skills !== "") ? skills.split(",").map(function(s){return s.trim();}) : [];
var certsList = (typeof certifications !== 'undefined' &amp;&amp; certifications !== "") ? certifications.split(",").map(function(c){return c.trim();}) : [];

// 3. Création de l'objet structuré selon le modèle imposé
var elastic_document = {
    "job_id": job_id,
    "source_name": source_name,
    "redirect_url": redirect_url,
    "posting": {
        "date": posting_date,
        "year": parseInt(posting_year),
        "month": parseInt(posting_month),
        "day": parseInt(posting_day)
    },
    "job_details": {
        "title": title,
        "role": (typeof role !== 'undefined') ? role : null,
 		"contract_type": contract_type,
        "experience": {
            "experience_level": (typeof experience_level !== 'undefined') ? experience_level : "unknown",
            "experience_raw": (typeof experience_raw !== 'undefined') ? experience_raw : null,
            "experience_extraction_method": "llm"
        },
        "requirements": {
            "certifications": certsList,
            "skills": skillsList,
            "skills_extraction_method": "llm"
        },
       
    },
    "company": {
        "name": cleanCompanyName,
        "size": (typeof company_size_label !== 'undefined') ? company_size_label : "unknown",
        "profile": (typeof company_profile !== 'undefined') ? company_profile : null
    },
    "location": {
        "city": city,
        "country": country,
        "area": location_area,
        "latitude": parseFloat(latitude),
        "longitude": parseFloat(longitude)
    },
    "category": {
        "name": category_name, 
        "tag": category_tag
    },
    "salary": {
        "min": parseFloat(salary_min),
        "max": parseFloat(salary_max),
        "range": (typeof salary_raw !== 'undefined') ? salary_raw : null,
        "is_predicted": true
    }
};

var final_json_output = JSON.stringify(elastic_document);</jsScript_script>
      </jsScript>
    </jsScripts>
