  <transform>
    <name>JavaScript 3</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// Parser la réponse de Groq
var experience_level = "unknown";
var category_name = "unknown";
var category_tag = "unknown";
var certifications_list = "[]";

try {
  var response = JSON.parse(groq_response);
  var content = response.choices[0].message.content;
  
  // Nettoyer le markdown si présent
  content = content.replace(/```json/g, "").replace(/```/g, "").trim();
  
  var extracted = JSON.parse(content);
  
  if (extracted.experience_level) experience_level = extracted.experience_level;
  if (extracted.category_name) category_name = extracted.category_name;
  if (extracted.category_tag) category_tag = extracted.category_tag;
  if (extracted.certifications) certifications_list = JSON.stringify(extracted.certifications);
  
} catch(e) {
  // Valeurs par défaut si erreur

}</jsScript_script>
      </jsScript>
    </jsScripts>
