    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// Salary conversion
var salary_min = 0;
var salary_max = 0;
var salary_range_str = "";

if (salary_raw != null &amp;&amp; salary_raw != "") {
  var parts = salary_raw.replace(/\$/g, '').replace(/K/g, '000').split('-');
  if (parts.length == 2) {
    salary_min = parseInt(parts[0].trim());
    salary_max = parseInt(parts[1].trim());
    salary_range_str = "from " + salary_raw.split('-')[0].trim() + " to " + salary_raw.split('-')[1].trim();
  }
}

// Company size conversion
var company_size_label = "unknown";
if (company_size != null) {
  var size = parseInt(company_size);
  if (size &lt; 500) company_size_label = "small";
  else if (size &lt; 2000) company_size_label = "mid";
  else if (size &lt; 10000) company_size_label = "big";
  else company_size_label = "big";
}</jsScript_script>
      </jsScript>
    </jsScripts>
