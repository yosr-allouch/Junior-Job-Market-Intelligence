    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var groq_body = JSON.stringify({
  "model": "llama-3.1-8b-instant",
  "temperature": 0,
  "max_tokens": 300,
  "stream": false,
  "messages": [
    {
      "role": "system",
      "content": "You are a strict job market analyst. Return ONLY valid JSON. No explanations. No markdown. No extra text."
    },
    {
      "role": "user",
     "content": "Extract information from this job posting.\n\n" +
  "Title: " + title + "\n" +
  "Role: " + role + "\n" +
  "Experience: " + experience_raw + "\n" +
  "Qualifications: " + certifications + "\n" +
  "Description: " + job_description.substring(0, 400) + "\n\n" +
  "Return ONLY a valid JSON object following this structure exactly:\n" +
  "{\n" +
  "  \"experience_level\": \"(choose one: Junior, Mid, Senior, or Unknown)\",\n" +
  "  \"category_name\": \"(the general job category)\",\n" +
  "  \"category_tag\": \"(a slug version of the category, e.g., healthcare-jobs)\",\n" +
  "  \"certifications\": [\"list\", \"of\", \"found\", \"certifications\"]\n" +
  "}"
 }
  ]
});

var groq_auth = "Bearer ${GROQ_API_KEY}";
var groq_content_type = "application/json";</jsScript_script>
      </jsScript>
    </jsScripts>
